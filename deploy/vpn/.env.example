# Скопировать в .env рядом с docker-compose.yml. Реальные значения — в Bitwarden, в git не класть.
# Комментарии — только на отдельных строках.

# Mongo. Имя базы — как на старом сервере, иначе дамп восстановится не туда.
# Пароль: openssl rand -hex 24 (только hex: пароль подставляется в MONGO_URL)
MONGO_USER=docfill
MONGO_PASSWORD=
MONGO_DB=document-fill

# JWT — новые значения, каждое: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
TOKEN_PEPPER=

# Перенести со старого сервера БЕЗ ИЗМЕНЕНИЙ: иначе старые .docx не откроются для обновления
DOCUMENT_ENCRYPTION_KEY=

# Telegram-бот (пусто — бот выключен). Один токен — один запущенный бот:
# перед запуском здесь остановить backend на старом сервере.
TELEGRAM_BOT_TOKEN=
